DATABASE_URL=sqlite:///./dev.db

# Default: SQLite, no server setup needed for local dev.
# For PostgreSQL instead (production-parity, needed to properly test
# checkout's row-locking behavior under concurrency), comment out the
# line above and uncomment below:
# DATABASE_URL=postgresql://user:password@localhost:5432/ecommerce
JWT_SECRET_KEY=change-me-to-a-long-random-value
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440
CORS_ORIGINS=http://localhost:3000
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=ChangeThisPassword123!